<Window x:Class="ThuAo.Classroom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settingoverlay="clr-namespace:ThuAo"
        Title="Classroom" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Hiệu ứng click thu phóng ảnh -->
        <Storyboard x:Key="ImageClickEffect">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                 To="0.85" Duration="0:0:0.05" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                 To="0.85" Duration="0:0:0.05" AutoReverse="True"/>
        </Storyboard>
        <Storyboard x:Key="ClickEffectStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                To="1.2" Duration="0:0:0.1" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                To="1.2" Duration="0:0:0.1" AutoReverse="True"/>
        </Storyboard>
        <!-- Các style y hệt file FeedWindow -->
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE3F2FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF90CAF9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFBBDEFB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF64B5F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Nền -->
        <Image Source="/Assets/classroom.png" Stretch="Fill" />

        <!-- Các thanh trạng thái -->
        <Grid Margin="10,0,0,400" Height="70" HorizontalAlignment="Left" Width="780" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <!-- Ngủ -->
                <ColumnDefinition Width="1*"/>
                <!-- Thức ăn -->
                <ColumnDefinition Width="1*"/>
                <!-- Học bài -->
                <ColumnDefinition Width="Auto"/>
                <!-- Xu đang có -->
            </Grid.ColumnDefinitions>

            <!-- Ngủ -->
            <StackPanel Margin="0,20,0,0" Width="250" HorizontalAlignment="Center">
                <Grid Width="170" Height="40" Margin="10,0">
                    <Image Source="Assets/Button/ngu/bg.png" Stretch="Fill"/>
                    <Border Width="160" Height="20" 
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Center" 
                            CornerRadius="10" 
                            ClipToBounds="True" 
                            RenderTransformOrigin="0.573,0.52" Margin="5,0,0,0">
                        <Image x:Name="HealthFill2"
               Source="Assets/Button/ngu/blood-03.png"
               Stretch="Fill" Margin="33,0,-8,0" RenderTransformOrigin="0.519,0.522"/>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Thức ăn -->
            <StackPanel Grid.Column="1" Margin="0,20,0,0" Width="250" HorizontalAlignment="Center">
                <Grid Width="170" Height="40" Margin="10,0">
                    <Image Source="Assets/Button/thuc_an/bg.png" Stretch="Fill" HorizontalAlignment="Left" Width="170" Margin="-10,0,0,0"/>
                    <Border Width="160" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" 
CornerRadius="10" ClipToBounds="True" RenderTransformOrigin="0.573,0.52">
                        <Image x:Name="HealthFill1"
   Source="Assets/Button/thuc_an/blood.png"
   Stretch="Fill" Margin="24,0,10,0" RenderTransformOrigin="0.519,0.522"/>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Học bài -->
            <StackPanel Grid.Column="2" Margin="0,20,0,0" Width="250" HorizontalAlignment="Center">
                <Grid Width="170" Height="40" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="0*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="Assets/Button/hoc_bai/bg.png"
                           Stretch="Fill" 
                           HorizontalAlignment="Left" 
                           Width="170" Margin="-10,0,0,0" 
                           Grid.ColumnSpan="2"/>
                    <Border Width="160" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" 
                    CornerRadius="10" ClipToBounds="True" RenderTransformOrigin="0.573,0.52">
                        <Image x:Name="HealthFill3"
                                Source="Assets/Button/hoc_bai/blood-03.png"
                                Stretch="Fill" Margin="22,0,10,0" RenderTransformOrigin="0.519,0.522"/>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Xu đang có -->
            <StackPanel Grid.Column="3" Margin="0,20,20,0" Width="140" HorizontalAlignment="Center">
                <Button Width="160" Height="40" BorderThickness="0" Background="Transparent" Cursor="Hand">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="7*"/>
                            <RowDefinition Height="31*"/>
                        </Grid.RowDefinitions>
                        <!-- Hình nền nút -->
                        <Image Source="Assets/button/coin/coin.png" Stretch="Fill" HorizontalAlignment="Left" Width="130" Height="40" Margin="-32,0,0,-2" Grid.RowSpan="2"/>
                        <!-- Text hiện số xu -->
                        <TextBlock x:Name="CoinTextBlock"
                           Text="100"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="16"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left" Margin="27,2,0,0" Grid.Row="1"/>

                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Nút Cài đặt và Âm thanh -->
        <StackPanel Orientation="Vertical"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,70,10,0" Grid.ColumnSpan="2">
            <!-- Nút Âm thanh -->
            <Image x:Name="SoundImage"
                   Source="Assets/Button/setting/am_thanh.png"
                   Width="60" Height="60" Margin="5"
                   MouseLeftButtonUp="SoundImage_MouseLeftButtonUp"
                   ToolTip="Bật/Tắt âm thanh" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform/>
                </Image.RenderTransform>
                <Image.Clip>
                    <EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30"/>
                </Image.Clip>
            </Image>

            <!-- Nút Cài đặt -->
            <Image Source="Assets/Button/setting/setting.png"
                   Width="60" Height="60" Margin="5"
                   MouseLeftButtonUp="SettingsImage_MouseLeftButtonUp"
                   ToolTip="Cài đặt" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform/>
                </Image.RenderTransform>
                <Image.Clip>
                    <EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30"/>
                </Image.Clip>
            </Image>

            <!-- Nút menu 3 gạch -->
            <Image Source="Assets/Button/setting/more.png"
                   Width="60" Height="60" Margin="5"
                   MouseLeftButtonUp="MenuImage_MouseLeftButtonUp"
                   ToolTip="Menu" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform/>
                </Image.RenderTransform>
                <Image.Clip>
                    <EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30"/>
                </Image.Clip>
            </Image>
        </StackPanel>
        
        <!-- Nút chuyển hướng -->
        <StackPanel Orientation="Horizontal"
         HorizontalAlignment="Left"
         VerticalAlignment="Bottom"
         Margin="610,0,0,0" Height="80" Width="176">
            <!-- Quay lại -->
            <Image Source="Assets/Button/setting/left.png"
             Width="70" Height="70" Margin="10"
             MouseLeftButtonUp="ArrowImage_MouseLeftButtonUp"
             ToolTip="Nút mũi tên"
             Cursor="Hand"/>

            <!-- Tiến lên -->
            <Image Source="Assets/Button/setting/right.png"
             Width="70" Height="70" Margin="10"
             MouseLeftButtonUp="ArrowImage_MouseLeftButtonUp"
             ToolTip="Nút mũi tên"
             Cursor="Hand" />
        </StackPanel>

        <Border Background="White" CornerRadius="10" Padding="20"
        HorizontalAlignment="Center" VerticalAlignment="Center"
        BorderBrush="Gray" BorderThickness="1" Width="630" Height="293">
            <StackPanel>
                <!-- Câu hỏi -->
                <TextBlock x:Name="QuestionText" Text="Câu hỏi sẽ hiện ở đây"
                   FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                   Margin="0 0 0 20" />

                <!-- Các đáp án -->
                <StackPanel x:Name="AnswerPanel">
                    <TextBlock x:Name="OptionA" Text="A. ..." Margin="0 5"
                       FontSize="16" Padding="10"
                       Background="#EEEEEE" Cursor="Hand"
                       MouseLeftButtonUp="Answer_Click"/>
                    <TextBlock x:Name="OptionB" Text="B. ..." Margin="0 5"
                       FontSize="16" Padding="10"
                       Background="#EEEEEE" Cursor="Hand"
                       MouseLeftButtonUp="Answer_Click"/>
                    <TextBlock x:Name="OptionC" Text="C. ..." Margin="0 5"
                       FontSize="16" Padding="10"
                       Background="#EEEEEE" Cursor="Hand"
                       MouseLeftButtonUp="Answer_Click"/>
                    <TextBlock x:Name="OptionD" Text="D. ..." Margin="0 5"
                       FontSize="16" Padding="10"
                       Background="#EEEEEE" Cursor="Hand"
                       MouseLeftButtonUp="Answer_Click"/>
                </StackPanel>

                <!-- Kết quả -->
                <TextBlock x:Name="ResultText" Text=""
                   FontSize="16" FontWeight="SemiBold" Foreground="Green"
                   HorizontalAlignment="Center" Margin="0 10 0 0"/>
            </StackPanel>
        </Border>

        <!-- Lớp phủ Setting -->
        <settingoverlay:SettingOverlay x:Name="SettingControl" />
    </Grid>
</Window>