                <TextBlock Text="10 xu"
               Foreground="White"
               FontWeight="Bold"
               FontSize="14"
               HorizontalAlignment="Center"
               Margin="0,-2,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,10,0,0">
