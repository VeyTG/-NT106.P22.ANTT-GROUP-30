<Window x:Class="ThuAo.Welcome"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Pet" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Hiệu ứng click thu phóng ảnh -->
        <Storyboard x:Key="ImageClickEffect">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                 To="0.85" Duration="0:0:0.05" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                 To="0.85" Duration="0:0:0.05" AutoReverse="True"/>
        </Storyboard>
        <Storyboard x:Key="ClickEffectStoryboard">
            <DoubleAnimation
        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
        To="1.2" Duration="0:0:0.1" AutoReverse="True"/>
            <DoubleAnimation
        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
        To="1.2" Duration="0:0:0.1" AutoReverse="True"/>
        </Storyboard>
        <!-- Hiệu ứng đổ bóng cho nút -->
        <DropShadowEffect x:Key="ButtonShadowEffect"
                          Color="Black"
                          Direction="320"
                          ShadowDepth="5"
                          Opacity="0.5"
                          BlurRadius="10"/>

        <!-- Style nút Play có CornerRadius và hiệu ứng -->
        <Style x:Key="PlayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="177"/>
            <Setter Property="Height" Value="62"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder"
                                Background="#FF61C0BF"
                                BorderBrush="#FF3A7D7D"
                                BorderThickness="2"
                                CornerRadius="30"
                                Effect="{StaticResource ButtonShadowEffect}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Triggers cho hiệu ứng Hover và Pressed -->
                        <ControlTemplate.Triggers>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#FF4DB8B0"/>
                            </Trigger>

                            <!-- Pressed -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#FF3A9993"/>
                                <Setter TargetName="buttonBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Hình nền -->
        <Image Source="Assets/START.png" Stretch="Fill" />

        <TextBlock Text="Chào mừng bạn đến với thế giới thú ảo!"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
           Margin="35,113,0,0"
           FontSize="36"
           FontWeight="Bold"
           Foreground="#F2507C"
           TextWrapping="Wrap" Width="755"/>
 
        <!-- Nút Play -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="214,0,0,47"
                    Height="82" Width="186">
            <Button x:Name="PlayButton"
                    Style="{StaticResource PlayButtonStyle}"
                    Click="PlayButton_Click">
                <TextBlock Text="Bắt đầu"
                           FontWeight="Bold"
                           Foreground="White"
                           FontSize="32"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
